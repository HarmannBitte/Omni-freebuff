# ── freebuff2api ──────────────────────────────────────────────
# Comma-separated for concurrency: each FreeBuff account = 1 global active
# session, so N tokens = N parallel session slots.
# Get yours via: ./extract-freebuff-token.sh  (after `freebuff` login)
FREEBUFF_TOKEN=

# Optional auth for the local router's /v1/* surface.
# If set, OmniRoute must send `Authorization: Bearer <ROUTER_KEY>`.
ROUTER_KEY=

# Optional: point at an alternate config file
# ROUTER_CONFIG=./router.config.json

# ── OmniRoute ─────────────────────────────────────────────────
# Dashboard + OpenAI-compatible API (same port by default)
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
# Management-scoped key (Dashboard → Endpoints → create key with manage scope)
# Used by create-omniroute-combo.sh
OMNIROUTE_MANAGE_KEY=
# Chat-scoped key your agent loop uses at runtime
OMNIROUTE_CHAT_KEY=

# ── Agent loop ────────────────────────────────────────────────
# The combo name created in OmniRoute (see create-omniroute-combo.sh)
AGENT_MODEL=never-stop-coding
AGENT_WORKSPACE=./workspace
AGENT_MAX_STEPS=50
